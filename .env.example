# Openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_MODEL=your-openrouter-selected-model

# OAuth 2.0 — ЭИОС МГУ им. Огарёва
EIOS_CLIENT_ID=your-eios_client_id
EIOS_CLIENT_SECRET=your-eios_client_secret
EIOS_REDIRECT_URI=http://localhost:64548/signin-eios

# Роль, которая даёт доступ к приложению. Оставь пустым — пропустит всех (для отладки).
EIOS_ALLOWED_ROLE=

# Секрет для подписи сессионных cookie (замените на случайную строку)
SESSION_SECRET_KEY=your-session_secret_key

# LLM — дополнительные параметры (опционально, есть defaults в config.py)
# Таймаут запроса к OpenRouter в секундах
LLM_REQUEST_TIMEOUT=120
# Размер батча уникальных ответов для группировки
LLM_GROUP_BATCH_SIZE=50
# Максимальное число параллельных запросов при группировке
LLM_GROUP_MAX_CONCURRENCY=3
